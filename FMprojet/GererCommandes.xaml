<Window x:Class="FMprojet.Views.GererCommandes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gérer les Commandes" Height="620" Width="920"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Window.Resources>
        <!-- Style cellule statut -->
        <Style x:Key="StatutText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Statut}" Value="confirmee">
                    <Setter Property="Foreground" Value="#1A8A4A"/>
                    <Setter Property="Background" Value="#D4F0E0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statut}" Value="annulee">
                    <Setter Property="Foreground" Value="#C0392B"/>
                    <Setter Property="Background" Value="#FAD7D7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statut}" Value="en_attente">
                    <Setter Property="Foreground" Value="#D35400"/>
                    <Setter Property="Background" Value="#FDE8CB"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Style bouton action -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="#1A2332" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📋  Gérer les Commandes" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="txtCompteurCommandes" Text="Chargement…" FontSize="12" Foreground="#8FA3B8" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="← Retour" Click="BtnRetour_Click"
                        Background="#E74C3C" Style="{x:Null}"
                        Foreground="White" Padding="12,7" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C0392B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Barre de filtres -->
        <Border Grid.Row="1" Background="White" Padding="16,10" BorderBrush="#DDE3EA" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtRecherche"
                         Grid.Column="0"
                         Padding="10,7"
                         FontSize="13"
                         Margin="0,0,10,0"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         TextChanged="Filtre_Changed">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Resources>
                                <VisualBrush x:Key="HintBrush" Stretch="None" AlignmentX="Left">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="🔍  Rechercher par utilisateur ou véhicule…"
                                                   Foreground="#AAAAAA" FontSize="13" Margin="2,0"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="Background" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Grid.Column="1" Text="Date :" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555"/>
                <DatePicker x:Name="dpFiltrDate" Grid.Column="2"
                            Margin="0,0,10,0"
                            Width="130"
                            VerticalAlignment="Center"
                            SelectedDateChanged="Filtre_Changed"/>
                <Button Grid.Column="3" Content="✕ Réinitialiser" Click="BtnReinitFiltres_Click"
                        Background="#95A5A6" Foreground="White" BorderThickness="0"
                        Padding="10,6" Cursor="Hand" FontSize="12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#7F8C8D"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Zone principale : liste ou message vide -->
        <Grid Grid.Row="2">
            <!-- Message si vide -->
            <StackPanel x:Name="panneauVide" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Aucune commande trouvée pour le moment"
                           FontSize="15" Foreground="#95A5A6" HorizontalAlignment="Center"/>
                <TextBlock Text="Essayez de modifier les filtres de recherche"
                           FontSize="12" Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Liste des commandes -->
            <ListView x:Name="listCommandes" Margin="0" BorderThickness="0"
                      Background="Transparent"
                      SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="50">
                            <GridViewColumnHeader Content="ID" Click="ColonneEntete_Click" Tag="Id"
                                                  Cursor="Hand" FontWeight="SemiBold"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id}" Foreground="#7F8C8D"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="160">
                            <GridViewColumnHeader Content="Utilisateur" Click="ColonneEntete_Click" Tag="UtilisateurNom"
                                                  Cursor="Hand" FontWeight="SemiBold"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UtilisateurNom}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="160">
                            <GridViewColumnHeader Content="Véhicule" Click="ColonneEntete_Click" Tag="VehiculeMarqueModele"
                                                  Cursor="Hand" FontWeight="SemiBold"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding VehiculeMarqueModele}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="115">
                            <GridViewColumnHeader Content="📅 Date" Click="ColonneEntete_Click" Tag="DateCommande"
                                                  Cursor="Hand" FontWeight="SemiBold"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DateCommande, StringFormat=dd/MM/yyyy}" Foreground="#555"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="130">
                            <GridViewColumnHeader Content="Statut" FontWeight="SemiBold"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="1">
                                        <TextBlock Text="{Binding StatutLibelle}" Style="{StaticResource StatutText}"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Actions" Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Approuver : visible seulement si "En attente" -->
                                        <Button Content="✔ Approuver"
                                                Background="#27AE60"
                                                Margin="0,0,4,0"
                                                Tag="{Binding Id}"
                                                Click="BtnApprouver_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Statut}" Value="en_attente">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <!-- Refuser : visible seulement si "En attente" -->
                                        <Button Content="✖ Refuser"
                                                Background="#E74C3C"
                                                Tag="{Binding Id}"
                                                Click="BtnRefuser_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Statut}" Value="en_attente">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <!-- Style alternance des lignes -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="4,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EBF5FB"/>
                                <Setter Property="Foreground" Value="#1A2332"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <!-- Pied de page -->
        <Border Grid.Row="3" Background="#E8ECF0" Padding="16,8">
            <TextBlock x:Name="txtStatutBarre" Text="" FontSize="12" Foreground="#7F8C8D"/>
        </Border>
    </Grid>
</Window>
