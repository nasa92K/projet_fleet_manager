<Window x:Class="FMprojet.Views.Connexion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion - Fleet Manager" 
        Height="450" 
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="{StaticResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Navy}" Padding="20">
            <StackPanel>
                <TextBlock Text="Fleet Manager" 
                          FontSize="28" 
                          FontWeight="Bold" 
                          Foreground="White" 
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Système de gestion de flotte" 
                          FontSize="14" 
                          Foreground="#ECF0F1" 
                          HorizontalAlignment="Center" 
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Formulaire de connexion -->
        <Border Grid.Row="1" Margin="24" Padding="22" Background="White" CornerRadius="14">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Connexion" 
                      FontSize="24" 
                      FontWeight="Bold" 
                      Margin="0,0,0,30" 
                      HorizontalAlignment="Center"/>

            <!-- Email -->
            <TextBlock Text="Email :" 
                      FontSize="14" 
                      FontWeight="SemiBold" 
                      Margin="0,0,0,5"/>
            <TextBox x:Name="txtEmail" 
                    Height="40" 
                    FontSize="14" 
                    Margin="0,0,0,20"
                    GotFocus="TextBox_GotFocus"
                    LostFocus="TextBox_LostFocus"/>

            <!-- Mot de passe -->
            <TextBlock Text="Mot de passe :" 
                      FontSize="14" 
                      FontWeight="SemiBold" 
                      Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtMotDePasse" 
                        Height="40" 
                        FontSize="14" 
                        Margin="0,0,0,30"
                        KeyDown="PasswordBox_KeyDown"/>

            <!-- Message d'erreur -->
            <TextBlock x:Name="txtMessageErreur" 
                      Foreground="Red" 
                      FontSize="12" 
                      Margin="0,0,0,10"
                      TextWrapping="Wrap"
                      Visibility="Collapsed"/>

            <!-- Bouton de connexion -->
            <Button x:Name="btnConnexion" 
                   Content="Se connecter" 
                   Height="46"
                   FontSize="15"
                   Style="{StaticResource PrimaryButton}"
                   Margin="0,0,0,15"
                   Click="BtnConnexion_Click"/>

            <!-- Lien vers inscription -->
            <TextBlock HorizontalAlignment="Center" 
                      FontSize="12" 
                      Margin="0,10,0,0">
                <Run Text="Pas encore de compte ? "/>
                <Hyperlink x:Name="lnkInscription" 
                          Click="LnkInscription_Click"
                          Foreground="#3498DB">
                    <Run Text="S'inscrire"/>
                </Hyperlink>
            </TextBlock>
        </StackPanel>
        </Border>
    </Grid>
</Window>
