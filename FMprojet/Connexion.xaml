<Window x:Class="FMprojet.Views.Connexion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion - Fleet Manager" 
        Height="450" 
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <StackPanel>
                <TextBlock Text="Fleet Manager" 
                          FontSize="28" 
                          FontWeight="Bold" 
                          Foreground="White" 
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Système de gestion de flotte" 
                          FontSize="14" 
                          Foreground="#ECF0F1" 
                          HorizontalAlignment="Center" 
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Formulaire de connexion -->
        <StackPanel Grid.Row="1" 
                   Margin="40" 
                   VerticalAlignment="Center">

            <TextBlock Text="Connexion" 
                      FontSize="24" 
                      FontWeight="Bold" 
                      Margin="0,0,0,30" 
                      HorizontalAlignment="Center"/>

            <!-- Email -->
            <TextBlock Text="Email :" 
                      FontSize="14" 
                      FontWeight="SemiBold" 
                      Margin="0,0,0,5"/>
            <TextBox x:Name="txtEmail" 
                    Height="40" 
                    FontSize="14" 
                    Padding="10" 
                    Margin="0,0,0,20"
                    BorderBrush="#BDC3C7"
                    BorderThickness="1"
                    GotFocus="TextBox_GotFocus"
                    LostFocus="TextBox_LostFocus"/>

            <!-- Mot de passe -->
            <TextBlock Text="Mot de passe :" 
                      FontSize="14" 
                      FontWeight="SemiBold" 
                      Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtMotDePasse" 
                        Height="40" 
                        FontSize="14" 
                        Padding="10" 
                        Margin="0,0,0,30"
                        BorderBrush="#BDC3C7"
                        BorderThickness="1"
                        KeyDown="PasswordBox_KeyDown"/>

            <!-- Message d'erreur -->
            <TextBlock x:Name="txtMessageErreur" 
                      Foreground="Red" 
                      FontSize="12" 
                      Margin="0,0,0,10"
                      TextWrapping="Wrap"
                      Visibility="Collapsed"/>

            <!-- Bouton de connexion -->
            <Button x:Name="btnConnexion" 
                   Content="Se connecter" 
                   Height="45" 
                   FontSize="16" 
                   FontWeight="Bold"
                   Background="#3498DB" 
                   Foreground="White" 
                   BorderThickness="0"
                   Cursor="Hand"
                   Margin="0,0,0,15"
                   Click="BtnConnexion_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#3498DB"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980B9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#95A5A6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Lien vers inscription -->
            <TextBlock HorizontalAlignment="Center" 
                      FontSize="12" 
                      Margin="0,10,0,0">
                <Run Text="Pas encore de compte ? "/>
                <Hyperlink x:Name="lnkInscription" 
                          Click="LnkInscription_Click"
                          Foreground="#3498DB">
                    <Run Text="S'inscrire"/>
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
