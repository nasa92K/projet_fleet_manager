<Window x:Class="FMprojet.Views.GererVehicules"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Gestion des Véhicules" Height="720" Width="1060" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Navy}" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🚗  Gestion des véhicules" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="txtVehiculeStatut" Text="" FontSize="12" Foreground="#8FA3B8" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="← Retour" Click="BtnRetour_Click" Style="{StaticResource DangerButton}" Padding="12,8"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Liste -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Véhicules" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Navy}"/>

                    <ListView x:Name="listVehicules" Grid.Row="1" Margin="0,10,0,10" BorderThickness="0"
                              SelectionChanged="ListVehicules_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                <GridViewColumn Header="Marque" DisplayMemberBinding="{Binding Marque}" Width="120"/>
                                <GridViewColumn Header="Modèle" DisplayMemberBinding="{Binding Modele}" Width="140"/>
                                <GridViewColumn Header="Immat." DisplayMemberBinding="{Binding Immatriculation}" Width="120"/>
                                <GridViewColumn Header="Année" DisplayMemberBinding="{Binding Annee}" Width="70"/>
                                <GridViewColumn Header="KM" DisplayMemberBinding="{Binding Kilometrage}" Width="80"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Expander Grid.Row="2" Header="Ajouter un véhicule" Margin="0,0,0,10" IsExpanded="False">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Marque" Foreground="#555"/>
                                <TextBox x:Name="txtMarque"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Modèle" Foreground="#555"/>
                                <TextBox x:Name="txtModele"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Immatriculation" Foreground="#555" Margin="0,10,0,0"/>
                                <TextBox x:Name="txtImmatriculation" Margin="0,10,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Année" Foreground="#555" Margin="0,10,0,0"/>
                                <TextBox x:Name="txtAnnee" Margin="0,10,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Prix" Foreground="#555" Margin="0,10,0,0"/>
                                <TextBox x:Name="txtPrix" Margin="0,10,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Kilométrage" Foreground="#555" Margin="0,10,0,0"/>
                                <TextBox x:Name="txtKilometrage" Margin="0,10,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3">
                                <TextBlock Text="Carburant" Foreground="#555" Margin="0,10,0,0"/>
                                <TextBox x:Name="txtCarburant" Margin="0,10,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2">
                                <TextBlock Text="Transmission" Foreground="#555" Margin="0,10,0,0"/>
                                <TextBox x:Name="txtTransmission" Margin="0,10,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4">
                                <TextBlock Text="Catégorie ID" Foreground="#555" Margin="0,10,0,0"/>
                                <TextBox x:Name="txtCategorieId" Margin="0,10,0,0" Text="1"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <TextBlock Text="Image" Foreground="#555" Margin="0,10,0,0"/>
                                <TextBox x:Name="txtImage" Margin="0,10,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.ColumnSpan="3">
                                <TextBlock Text="Description" Foreground="#555" Margin="0,10,0,0"/>
                                <TextBox x:Name="txtDescription" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Expander>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Ajouter" Click="BtnAjouterVehicule_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                        <Button Content="Modifier / Suivi" Click="BtnModifierVehicule_Click" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="Supprimer" Click="BtnSupprimerVehicule_Click" Style="{StaticResource DangerButton}" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Détails + graphique -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Détails &amp; suivi" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Navy}"/>
                    <TextBlock x:Name="txtVehiculeSelection" Grid.Row="1" Text="Sélectionne un véhicule…" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,10"/>

                    <Border Grid.Row="2" Background="{StaticResource Brush.Bg}" CornerRadius="10" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Dépenses (30 jours)" FontWeight="SemiBold" Foreground="{StaticResource Brush.Navy}"/>
                            <TextBlock x:Name="txtVehiculeChartInfo" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8"/>
                            <lvc:CartesianChart x:Name="chartVehiculeDepenses" Height="210"/>
                        </StackPanel>
                    </Border>

                    <GroupBox Grid.Row="3" Header="Saisie rapide (journalier)" Margin="0,12,0,0">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Date" Foreground="#555"/>
                            <DatePicker x:Name="dpSuiviDate" Grid.Column="1" />

                            <TextBlock Grid.Row="1" Text="Kilométrage" Foreground="#555" Margin="0,10,0,0"/>
                            <TextBox x:Name="txtSuiviKm" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"/>

                            <TextBlock Grid.Row="2" Text="Carburant (qte)" Foreground="#555" Margin="0,10,0,0"/>
                            <TextBox x:Name="txtSuiviCarbQte" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"/>

                            <TextBlock Grid.Row="3" Text="Carburant (prix)" Foreground="#555" Margin="0,10,0,0"/>
                            <TextBox x:Name="txtSuiviCarbPrix" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"/>

                            <TextBlock Grid.Row="4" Text="Péages (frais)" Foreground="#555" Margin="0,10,0,0"/>
                            <TextBox x:Name="txtSuiviPeage" Grid.Row="4" Grid.Column="1" Margin="0,10,0,0"/>
                        </Grid>
                    </GroupBox>

                    <Button Grid.Row="4" Content="Enregistrer le suivi du jour" Click="BtnEnregistrerSuivi_Click"
                            Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Pied -->
        <Border Grid.Row="2" Background="#E8ECF0" CornerRadius="12" Padding="12">
            <TextBlock x:Name="txtVehiculesFooter" Text="" Foreground="{StaticResource Brush.TextMuted}"/>
        </Border>
    </Grid>
</Window>
