<Window x:Class="FMprojet.Views.MesCommandes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mes Commandes" Height="540" Width="780"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Window.Resources>
        <Style x:Key="StatutText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Statut}" Value="Approuvée">
                    <Setter Property="Foreground" Value="#1A8A4A"/>
                    <Setter Property="Background" Value="#D4F0E0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statut}" Value="Refusée">
                    <Setter Property="Foreground" Value="#C0392B"/>
                    <Setter Property="Background" Value="#FAD7D7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statut}" Value="En attente">
                    <Setter Property="Foreground" Value="#D35400"/>
                    <Setter Property="Background" Value="#FDE8CB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statut}" Value="Terminée">
                    <Setter Property="Foreground" Value="#2C3E50"/>
                    <Setter Property="Background" Value="#E0E3E7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="#1A2332" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📋  Mes Commandes" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="txtSoustitre" Text="Chargement…" FontSize="12" Foreground="#8FA3B8" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="← Retour" Click="BtnRetour_Click"
                        Foreground="White" Padding="12,7" BorderThickness="0" Cursor="Hand" Background="#E74C3C">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C0392B"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Barre de recherche -->
        <Border Grid.Row="1" Background="White" Padding="16,10" BorderBrush="#DDE3EA" BorderThickness="0,0,0,1">
            <TextBox x:Name="txtRecherche"
                     Padding="10,7"
                     FontSize="13"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"
                     TextChanged="TxtRecherche_TextChanged">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Resources>
                            <VisualBrush x:Key="HintBrush" Stretch="None" AlignmentX="Left">
                                <VisualBrush.Visual>
                                    <TextBlock Text="🔍  Rechercher par véhicule ou statut…"
                                               Foreground="#AAAAAA" FontSize="13" Margin="2,0"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Style.Resources>
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>

        <!-- Zone liste / message vide -->
        <Grid Grid.Row="2">
            <StackPanel x:Name="panneauVide" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Aucune commande trouvée pour le moment"
                           FontSize="15" Foreground="#95A5A6" HorizontalAlignment="Center"/>
                <TextBlock Text="Commandez un véhicule depuis la page 'Voir les véhicules'"
                           FontSize="12" Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <ListView x:Name="listCommandes" BorderThickness="0" Background="Transparent">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" Width="55">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id}" Foreground="#7F8C8D"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Véhicule" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding VehiculeMarqueModele}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="📅 Date" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DateCommande, StringFormat=dd/MM/yyyy}" Foreground="#555"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Statut" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="1">
                                        <TextBlock Text="{Binding Statut}" Style="{StaticResource StatutText}"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="4,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EBF5FB"/>
                                <Setter Property="Foreground" Value="#1A2332"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <!-- Pied de page -->
        <Border Grid.Row="3" Background="#E8ECF0" Padding="16,8">
            <TextBlock x:Name="txtStatutBarre" Text="" FontSize="12" Foreground="#7F8C8D"/>
        </Border>
    </Grid>
</Window>