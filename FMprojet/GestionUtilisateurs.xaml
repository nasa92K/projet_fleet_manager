<Window x:Class="FMprojet.Views.GestionUtilisateurs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des Utilisateurs" Height="450" Width="600">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Gestion des Utilisateurs" FontSize="16" FontWeight="Bold" Margin="0,10"/>

            <!-- Liste des utilisateurs -->
            <ListView x:Name="listUtilisateurs" Margin="0,10">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                        <GridViewColumn Header="Nom" DisplayMemberBinding="{Binding Nom}" Width="100"/>
                        <GridViewColumn Header="Prénom" DisplayMemberBinding="{Binding Prenom}" Width="100"/>
                        <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" Width="150"/>
                        <GridViewColumn Header="Rôle" DisplayMemberBinding="{Binding Role}" Width="80"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Formulaire pour ajouter un utilisateur -->
            <TextBlock Text="Ajouter un Utilisateur" FontSize="14" FontWeight="Bold" Margin="0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Nom:" Width="80"/>
                <TextBox x:Name="txtNouveauNom" Width="150" Margin="5,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Prénom:" Width="80"/>
                <TextBox x:Name="txtNouveauPrenom" Width="150" Margin="5,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Email:" Width="80"/>
                <TextBox x:Name="txtNouveauEmail" Width="150" Margin="5,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Mot de passe:" Width="80"/>
                <PasswordBox x:Name="txtNouveauMotDePasse" Width="150" Margin="5,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Rôle:" Width="80"/>
                <ComboBox x:Name="cmbNouveauRole" Width="150" Margin="5,0">
                    <ComboBoxItem Content="utilisateur"/>
                    <ComboBoxItem Content="admin"/>
                </ComboBox>
            </StackPanel>

            <!-- Bouton pour ajouter l'utilisateur -->
            <Button Content="Ajouter" Click="BtnAjouterUtilisateur_Click" Margin="0,10" Padding="5,2" Width="100"/>

            <!-- Bouton Retour -->
            <Button Content="Retour" Click="BtnRetour_Click" Margin="0,10" Padding="5,2" Width="100"/>
        </StackPanel>
    </Grid>
</Window>