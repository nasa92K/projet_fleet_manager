<Window x:Class="FMprojet.Views.Inscription"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inscription" Height="400" Width="400">
    <Grid Margin="10">
        <StackPanel>
            <!-- Champs pour l'inscription -->
            <TextBlock Text="Nom:" Margin="0,5"/>
            <TextBox x:Name="txtNom" Margin="0,5"/>

            <TextBlock Text="Prénom:" Margin="0,5"/>
            <TextBox x:Name="txtPrenom" Margin="0,5"/>

            <TextBlock Text="Email:" Margin="0,5"/>
            <TextBox x:Name="txtEmail" Margin="0,5"/>

            <TextBlock Text="Mot de passe:" Margin="0,5"/>
            <PasswordBox x:Name="txtMotDePasse" Margin="0,5"/>

            <!-- Bouton pour s'inscrire -->
            <Button Content="S'inscrire" Click="BtnInscription_Click" Margin="0,10"/>
        </StackPanel>
    </Grid>
</Window>
