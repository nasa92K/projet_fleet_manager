<Window x:Class="FMprojet.Views.AdminVehiculesRemplacer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🚨 Véhicules à Remplacer - Fleet Manager"
        Height="700" Width="1150"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0F1623">

    <Window.Resources>
        <!-- Bouton action -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Champ texte sombre -->
        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Background"       Value="#0F1623"/>
            <Setter Property="Foreground"       Value="#EDF1FA"/>
            <Setter Property="BorderBrush"      Value="#1F2E45"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="9,7"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="CaretBrush"       Value="#E05C5C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Topbar -->
            <RowDefinition Height="Auto"/>
            <!-- KPI cards -->
            <RowDefinition Height="Auto"/>
            <!-- Filtres -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid -->
            <RowDefinition Height="*"/>
            <!-- Pied -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ TOPBAR ROUGE ═══ -->
        <Border Grid.Row="0" Background="#2A0D0D"
                BorderThickness="0,0,0,2" BorderBrush="#E05C5C"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚨" FontSize="24" VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Véhicules à Remplacer"
                                       FontSize="20" FontWeight="Bold" Foreground="#EDF1FA"/>
                            <TextBlock Text="Véhicules dépassant les critères : âge ≥ 4 ans ET kilométrage ≥ 80 000 km"
                                       FontSize="11" Foreground="#E05C5C" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="← Retour au dashboard"
                        Click="BtnRetour_Click"
                        Style="{StaticResource ActionBtn}"
                        Background="#3D8EF0"/>
            </Grid>
        </Border>

        <!-- ═══ CARTES KPI ═══ -->
        <Grid Grid.Row="1" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total à remplacer -->
            <Border Grid.Column="0" Background="#2A0D0D" CornerRadius="12" Padding="18,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3" Color="#E05C5C"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🚨  TOTAL À REMPLACER" FontSize="10" FontWeight="Bold"
                               Foreground="#E05C5C" Margin="0,0,0,6"/>
                    <TextBlock x:Name="txtKpiTotal" Text="—"
                               FontSize="36" FontWeight="Bold" Foreground="#E05C5C"/>
                    <TextBlock Text="véhicule(s)" FontSize="11" Foreground="#6B7FA8"/>
                </StackPanel>
            </Border>

            <!-- Kilométrage total cumulé -->
            <Border Grid.Column="2" Background="#1C2740" CornerRadius="12" Padding="18,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.2" Color="#000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🛣️  KM TOTAL CUMULÉ" FontSize="10" FontWeight="Bold"
                               Foreground="#F4A535" Margin="0,0,0,6"/>
                    <TextBlock x:Name="txtKpiKmTotal" Text="—"
                               FontSize="36" FontWeight="Bold" Foreground="#F4A535"/>
                    <TextBlock Text="kilomètres" FontSize="11" Foreground="#6B7FA8"/>
                </StackPanel>
            </Border>

            <!-- Âge moyen -->
            <Border Grid.Column="4" Background="#1C2740" CornerRadius="12" Padding="18,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.2" Color="#000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="📅  ÂGE MOYEN" FontSize="10" FontWeight="Bold"
                               Foreground="#9B72F2" Margin="0,0,0,6"/>
                    <TextBlock x:Name="txtKpiAgeMoyen" Text="—"
                               FontSize="36" FontWeight="Bold" Foreground="#9B72F2"/>
                    <TextBlock Text="ans en moyenne" FontSize="11" Foreground="#6B7FA8"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ BARRE DE FILTRES ═══ -->
        <Border Grid.Row="2" Background="#141D2E"
                BorderThickness="0,1,0,1" BorderBrush="#1F2E45"
                Padding="20,12" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍  Rechercher :"
                           FontSize="11" FontWeight="SemiBold" Foreground="#6B7FA8"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="txtRecherche"
                         Style="{StaticResource DarkInput}"
                         Width="220"
                         ToolTip="Rechercher par marque ou modèle"
                         TextChanged="TxtRecherche_TextChanged"/>
                <TextBlock Text="  Trier par :"
                           FontSize="11" FontWeight="SemiBold" Foreground="#6B7FA8"
                           VerticalAlignment="Center" Margin="20,0,10,0"/>
                <ComboBox x:Name="cbTri"
                          Background="#1C2740" Foreground="#EDF1FA"
                          Width="160" Padding="8,5"
                          SelectionChanged="CbTri_SelectionChanged">
                    <ComboBoxItem Content="Kilométrage ↓" IsSelected="True"/>
                    <ComboBoxItem Content="Âge ↓"/>
                    <ComboBoxItem Content="Marque A→Z"/>
                </ComboBox>
                <Button Content="🔄  Actualiser" Margin="20,0,0,0"
                        Click="BtnActualiser_Click"
                        Style="{StaticResource ActionBtn}"
                        Background="#3D8EF0"/>
            </StackPanel>
        </Border>

        <!-- ═══ DATAGRID ═══ -->
        <Border Grid.Row="3" Margin="20,12,20,0" Background="#1C2740" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22" Color="#000"/>
            </Border.Effect>
            <DataGrid x:Name="dgVehicules"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      Background="Transparent"
                      Foreground="#EDF1FA"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#1F2E45"
                      RowBackground="Transparent"
                      AlternatingRowBackground="#192236"
                      FontSize="12"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      ColumnHeaderHeight="38"
                      RowHeight="40"
                      Margin="0">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"      Value="#141D2E"/>
                        <Setter Property="Foreground"      Value="#3D8EF0"/>
                        <Setter Property="FontWeight"      Value="Bold"/>
                        <Setter Property="FontSize"        Value="10"/>
                        <Setter Property="Padding"         Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush"     Value="#1F2E45"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F2E45"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1E3A5F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"          Binding="{Binding Id}"             Width="50"/>
                    <DataGridTextColumn Header="MARQUE"      Binding="{Binding Marque}"          Width="110"/>
                    <DataGridTextColumn Header="MODÈLE"      Binding="{Binding Modele}"          Width="120"/>
                    <DataGridTextColumn Header="IMMAT."      Binding="{Binding Immatriculation}" Width="110"/>
                    <DataGridTextColumn Header="EN CIRCULATION" Binding="{Binding Circulation, StringFormat=dd/MM/yyyy}" Width="120"/>
                    <DataGridTextColumn Header="ANNÉE"       Binding="{Binding Annee}"           Width="65"/>
                    <DataGridTextColumn Header="ÂGE (ans)"   Binding="{Binding AgeCalcule}"      Width="75"/>
                    <DataGridTextColumn Header="KILOMÉTRAGE" Binding="{Binding Kilometrage, StringFormat=N0}" Width="100"/>

                    <!-- Colonne Statut avec badge coloré -->
                    <DataGridTemplateColumn Header="STATUT" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="6,3" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatutRemplacement}" Value="🚨 À REMPLACER">
                                                    <Setter Property="Background" Value="#3D1010"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatutRemplacement}" Value="⚠️ À MONITORER">
                                                    <Setter Property="Background" Value="#3A2A10"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatutRemplacement}" Value="✅ EN SERVICE">
                                                    <Setter Property="Background" Value="#0D2E1A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatutRemplacement}" FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatutRemplacement}" Value="🚨 À REMPLACER">
                                                        <Setter Property="Foreground" Value="#E05C5C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatutRemplacement}" Value="⚠️ À MONITORER">
                                                        <Setter Property="Foreground" Value="#F4A535"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatutRemplacement}" Value="✅ EN SERVICE">
                                                        <Setter Property="Foreground" Value="#1BC5BD"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Colonne Actions -->
                    <DataGridTemplateColumn Header="ACTIONS" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                    <Button Content="📋 Détails"
                                            Click="BtnDetails_Click"
                                            Tag="{Binding}"
                                            Background="#1E3A5F"
                                            Margin="0,0,4,0"
                                            Padding="6,4" FontSize="10"
                                            Cursor="Hand" BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Content="🗑️ Supprimer"
                                            Click="BtnSupprimer_Click"
                                            Tag="{Binding}"
                                            Background="#3D1010"
                                            Padding="6,4" FontSize="10"
                                            Cursor="Hand" BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                        CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ PIED ═══ -->
        <Border Grid.Row="4" Background="#141D2E"
                BorderThickness="0,1,0,0" BorderBrush="#1F2E45"
                Padding="20,10">
            <TextBlock x:Name="txtFooter"
                       Text="" FontSize="11" Foreground="#6B7FA8"/>
        </Border>
    </Grid>
</Window>
