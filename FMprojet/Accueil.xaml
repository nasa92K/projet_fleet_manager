<Window x:Class="FMprojet.Views.Accueil"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Accueil - Fleet Manager"
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">
    <Window.Resources>
        <!-- Style bouton de navigation standard -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style carte stat -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.12" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="#1A2332" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="txtBienvenue" 
                              Text="Bienvenue,"
                              FontSize="13"
                              Foreground="#8FA3B8"/>
                    <TextBlock x:Name="txtNomUtilisateur" 
                              Text="Utilisateur" 
                              FontSize="22" 
                              FontWeight="Bold"
                              Foreground="White"
                              Margin="0,2,0,0"/>
                    <TextBlock x:Name="txtRole" 
                              Text="Rôle" 
                              FontSize="13" 
                              Foreground="#8FA3B8" 
                              Margin="0,4,0,0"/>
                </StackPanel>

                <Button x:Name="btnChangerCompte" 
                       Grid.Column="1" 
                       Content="🔄  Changer de compte" 
                       Padding="15,8" 
                       Background="#E74C3C" 
                       Foreground="White" 
                       BorderThickness="0"
                       Cursor="Hand"
                       FontSize="13"
                       Click="BtnDeconnexion_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C0392B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Contenu principal -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,20">
            <StackPanel>

                <!-- ═══════════════════════════════════════ -->
                <!--   MENU SUPER ADMIN                      -->
                <!-- ═══════════════════════════════════════ -->
                <GroupBox x:Name="grpSuperAdmin" 
                         Header="☰  Menu Super Administrateur" 
                         Margin="0,0,0,20"
                         Padding="15"
                         Visibility="Collapsed">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="14" FontWeight="Bold" Foreground="#8E44AD"/>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <StackPanel>
                        <Button Content="👑  Gérer les administrateurs" 
                                Style="{StaticResource NavButton}"
                                Background="#8E44AD"
                                Click="BtnGererAdministrateurs_Click"/>
                        <Button Content="👥  Gérer les utilisateurs" 
                                Style="{StaticResource NavButton}"
                                Background="#3498DB"
                                Click="BtnGererUtilisateurs_Click"/>
                        <Button Content="🚗  Gérer les véhicules" 
                                Style="{StaticResource NavButton}"
                                Background="#16A085"
                                Click="BtnGererVehicules_Click"/>
                        <Button Content="📋  Gérer les commandes" 
                                Style="{StaticResource NavButton}"
                                Background="#F39C12"
                                Click="BtnGererCommandes_Click"/>
                        <Button Content="📊  Statistiques et rapports" 
                                Style="{StaticResource NavButton}"
                                Background="#34495E"
                                Click="BtnStatistiques_Click"/>
                    </StackPanel>
                </GroupBox>

                <!-- ═══════════════════════════════════════ -->
                <!--   MENU ADMIN — Dashboard avec compteurs  -->
                <!-- ═══════════════════════════════════════ -->
                <GroupBox x:Name="grpAdmin" 
                         Header="☰  Tableau de bord Administrateur" 
                         Margin="0,0,0,20"
                         Padding="15"
                         Visibility="Collapsed">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="14" FontWeight="Bold" Foreground="#2980B9"/>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <StackPanel>
                        <!-- Cartes stat -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Carte Véhicules -->
                            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="🚗" FontSize="28" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="txtNbVehicules"
                                               Text="—"
                                               FontSize="32"
                                               FontWeight="Bold"
                                               Foreground="#16A085"/>
                                    <TextBlock Text="Véhicules au total"
                                               FontSize="12"
                                               Foreground="#7F8C8D"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Carte Commandes en attente -->
                            <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="⏳" FontSize="28" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="txtNbCommandesEnAttente"
                                               Text="—"
                                               FontSize="32"
                                               FontWeight="Bold"
                                               Foreground="#E67E22"/>
                                    <TextBlock Text="Commandes en attente"
                                               FontSize="12"
                                               Foreground="#7F8C8D"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Graphiques -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Évolution des coûts (30 derniers jours)" FontWeight="SemiBold" Foreground="#1A2332"/>
                                    <TextBlock x:Name="txtDashChartInfo" Text="" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8"/>
                                    <lvc:CartesianChart x:Name="chartCouts" Height="220"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Dépenses flotte par catégorie (30 jours)" FontWeight="SemiBold" Foreground="#1A2332"/>
                                    <TextBlock x:Name="txtDashCatInfo" Text="" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,8"/>
                                    <lvc:PieChart x:Name="chartCategories" Height="220"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Boutons de navigation admin -->
                        <Button Content="👥  Gérer les utilisateurs" 
                                Style="{StaticResource NavButton}"
                                Background="#3498DB"
                                Click="BtnGererUtilisateurs_Click"/>
                        <Button Content="🚗  Gérer les véhicules" 
                                Style="{StaticResource NavButton}"
                                Background="#16A085"
                                Click="BtnGererVehicules_Click"/>
                        <Button Content="📋  Gérer les commandes" 
                                Style="{StaticResource NavButton}"
                                Background="#F39C12"
                                Click="BtnGererCommandes_Click"/>
                    </StackPanel>
                </GroupBox>

                <!-- ═══════════════════════════════════════ -->
                <!--   MENU UTILISATEUR                       -->
                <!-- ═══════════════════════════════════════ -->
                <GroupBox x:Name="grpUtilisateur" 
                         Header="☰  Menu Utilisateur" 
                         Margin="0,0,0,20" 
                         Padding="15"
                         Visibility="Collapsed">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="14" FontWeight="Bold" Foreground="#27AE60"/>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <StackPanel>
                        <Button Content="🚗  Voir les véhicules" 
                                Style="{StaticResource NavButton}"
                                Background="#3498DB"
                                Click="BtnVoirVehicules_Click"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Pied de page -->
        <Border Grid.Row="2" Background="#E8ECF0" Padding="12">
            <TextBlock Text="Fleet Manager — Système de gestion de flotte" 
                      FontSize="11" 
                      Foreground="#95A5A6" 
                      HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
