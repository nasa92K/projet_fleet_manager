<Window x:Class="FMprojet.Views.SuiviCommandes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FleetManager – Mes Commandes"
        Height="700" Width="1050"
        MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#1A1D2E">

    <Window.Resources>
        <!-- Bouton Primaire -->
        <Style x:Key="BtnPrimaire" TargetType="Button">
            <Setter Property="Background"      Value="#3B82F6"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton Secondaire -->
        <Style x:Key="BtnSecondaire" TargetType="Button" BasedOn="{StaticResource BtnPrimaire}">
            <Setter Property="Background" Value="#334155"/>
        </Style>

        <!-- En-tête colonnes DataGrid -->
        <Style x:Key="DgHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#1A1D2E"/>
            <Setter Property="Foreground"      Value="#94A3B8"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#334155"/>
        </Style>

        <!-- Ligne DataGrid -->
        <Style x:Key="DgRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize"   Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D3250"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E3A5F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cellule DataGrid -->
        <Style x:Key="DgCell" TargetType="DataGridCell">
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#F1F5F9"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="70"/>
            <!-- KPI -->
            <RowDefinition Height="Auto"/>
            <!-- Contenu principal -->
            <RowDefinition Height="*"/>
            <!-- Détail commande sélectionnée -->
            <RowDefinition Height="Auto"/>
            <!-- Pied -->
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- ═══ EN-TÊTE ═════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#252840"
                BorderThickness="0,0,0,1" BorderBrush="#334155">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#10B981" Margin="0,0,12,0">
                        <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mes Commandes" Foreground="#F1F5F9" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="txtSousTitre" Foreground="#94A3B8" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🚗  Commander un véhicule"
                            Style="{StaticResource BtnPrimaire}"
                            Background="#10B981" Padding="14,8"
                            Margin="0,0,10,0"
                            Click="BtnCommander_Click"/>
                    <Button Content="← Retour"
                            Style="{StaticResource BtnSecondaire}"
                            Padding="14,8"
                            Click="BtnRetour_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ KPI ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total commandes -->
            <Border Grid.Column="0" Background="#252840" CornerRadius="12" Padding="18,12">
                <StackPanel>
                    <TextBlock Text="📋  TOTAL" FontSize="9" FontWeight="Bold"
                               Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtKpiTotal" Text="0"
                               FontSize="32" FontWeight="Bold" Foreground="#3B82F6"/>
                    <TextBlock Text="commande(s)" FontSize="10" Foreground="#64748B"/>
                </StackPanel>
            </Border>

            <!-- En attente -->
            <Border Grid.Column="2" Background="#252840" CornerRadius="12" Padding="18,12">
                <StackPanel>
                    <TextBlock Text="⏳  EN ATTENTE" FontSize="9" FontWeight="Bold"
                               Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtKpiAttente" Text="0"
                               FontSize="32" FontWeight="Bold" Foreground="#F59E0B"/>
                    <TextBlock Text="en cours de traitement" FontSize="10" Foreground="#64748B"/>
                </StackPanel>
            </Border>

            <!-- Confirmées -->
            <Border Grid.Column="4" Background="#252840" CornerRadius="12" Padding="18,12">
                <StackPanel>
                    <TextBlock Text="✅  CONFIRMÉES" FontSize="9" FontWeight="Bold"
                               Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtKpiConfirmees" Text="0"
                               FontSize="32" FontWeight="Bold" Foreground="#10B981"/>
                    <TextBlock Text="validées par l'équipe" FontSize="10" Foreground="#64748B"/>
                </StackPanel>
            </Border>

            <!-- Annulées -->
            <Border Grid.Column="6" Background="#252840" CornerRadius="12" Padding="18,12">
                <StackPanel>
                    <TextBlock Text="❌  ANNULÉES" FontSize="9" FontWeight="Bold"
                               Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtKpiAnnulees" Text="0"
                               FontSize="32" FontWeight="Bold" Foreground="#EF4444"/>
                    <TextBlock Text="commandes annulées" FontSize="10" Foreground="#64748B"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ CONTENU PRINCIPAL ════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#252840" CornerRadius="12"
                Margin="24,14,24,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- En-tête panneau + filtre -->
                <Border Grid.Row="0" Padding="16,12"
                        BorderThickness="0,0,0,1" BorderBrush="#334155">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Historique de mes commandes"
                                   Foreground="#F1F5F9" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ComboBox x:Name="cbFiltre"
                                      Background="#1A1D2E" Foreground="#F1F5F9"
                                      Width="140" Padding="8,5"
                                      Margin="0,0,10,0"
                                      SelectionChanged="CbFiltre_SelectionChanged">
                                <ComboBoxItem Content="Tous les statuts" IsSelected="True"/>
                                <ComboBoxItem Content="En attente"/>
                                <ComboBoxItem Content="Confirmée"/>
                                <ComboBoxItem Content="Annulée"/>
                            </ComboBox>
                            <Button Content="↻ Actualiser"
                                    Style="{StaticResource BtnSecondaire}"
                                    Padding="12,7" FontSize="11"
                                    Click="BtnActualiser_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DataGrid des commandes -->
                <DataGrid Grid.Row="1"
                          x:Name="dgCommandes"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#2D3149"
                          RowHeaderWidth="0"
                          ColumnHeaderStyle="{StaticResource DgHeader}"
                          RowStyle="{StaticResource DgRow}"
                          CellStyle="{StaticResource DgCell}"
                          SelectionChanged="DgCommandes_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N° COMMANDE" Binding="{Binding Id}"       Width="110"/>
                        <DataGridTextColumn Header="VÉHICULE"    Binding="{Binding VehiculeMarqueModele}" Width="*"/>
                        <DataGridTextColumn Header="DATE"        Binding="{Binding DateCommande, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>

                        <!-- Colonne statut avec badge coloré -->
                        <DataGridTemplateColumn Header="STATUT" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="20" Padding="10,4" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#334155"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Statut}" Value="en_attente">
                                                        <Setter Property="Background" Value="#3A2A10"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Confirmée">
                                                        <Setter Property="Background" Value="#0D2E1A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Annulée">
                                                        <Setter Property="Background" Value="#3D1010"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="confirmee">
                                                        <Setter Property="Background" Value="#0D2E1A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="annulee">
                                                        <Setter Property="Background" Value="#3D1010"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatutAffiche}" FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Statut}" Value="en_attente">
                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Statut}" Value="Confirmée">
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Statut}" Value="Annulée">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Statut}" Value="confirmee">
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Statut}" Value="annulee">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ═══ PANNEAU DÉTAIL (commande sélectionnée) ═══════════════ -->
        <Border Grid.Row="3"
                x:Name="panneauDetail"
                Background="#1E2035"
                BorderThickness="0,1,0,0"
                BorderBrush="#334155"
                Margin="24,10,24,0"
                CornerRadius="12"
                Padding="20,14"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Infos commande sélectionnée -->
                <StackPanel>
                    <TextBlock Text="Commande sélectionnée" FontSize="10" FontWeight="Bold"
                               Foreground="#64748B" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtDetailNom"
                                   Foreground="#F1F5F9" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="bdDetailStatut"
                                CornerRadius="20" Padding="10,3" Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="txtDetailStatut"
                                       FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="txtDetailDate"
                               Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>

                    <!-- Timeline de progression -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <!-- Étape 1 : Reçue -->
                        <StackPanel x:Name="spEtape1" Width="130" HorizontalAlignment="Left">
                            <Border x:Name="bdEtape1" Width="32" Height="32" CornerRadius="16"
                                    Background="#10B981" HorizontalAlignment="Center">
                                <TextBlock Text="1" FontSize="13" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Commande reçue" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#10B981" TextAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Ligne -->
                        <Border x:Name="bdLigne1" Width="80" Height="2" VerticalAlignment="Top"
                                Margin="0,15,0,0">
                            <Border.Background>
                                <SolidColorBrush x:Name="brushLigne1" Color="#334155"/>
                            </Border.Background>
                        </Border>

                        <!-- Étape 2 : En cours -->
                        <StackPanel x:Name="spEtape2" Width="130" HorizontalAlignment="Left">
                            <Border x:Name="bdEtape2" Width="32" Height="32" CornerRadius="16"
                                    HorizontalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush x:Name="brushEtape2" Color="#334155"/>
                                </Border.Background>
                                <TextBlock Text="2" FontSize="13" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="txtEtape2Label" Text="En traitement"
                                       FontSize="10" FontWeight="SemiBold"
                                       TextAlignment="Center" Margin="0,4,0,0">
                                <TextBlock.Foreground>
                                    <SolidColorBrush x:Name="brushEtape2Text" Color="#64748B"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>

                        <!-- Ligne -->
                        <Border Width="80" Height="2" VerticalAlignment="Top" Margin="0,15,0,0">
                            <Border.Background>
                                <SolidColorBrush x:Name="brushLigne2" Color="#334155"/>
                            </Border.Background>
                        </Border>

                        <!-- Étape 3 : Terminée -->
                        <StackPanel Width="130" HorizontalAlignment="Left">
                            <Border x:Name="bdEtape3" Width="32" Height="32" CornerRadius="16"
                                    HorizontalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush x:Name="brushEtape3" Color="#334155"/>
                                </Border.Background>
                                <TextBlock x:Name="txtEtape3Icone" Text="3" FontSize="13" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="txtEtape3Label" Text="Terminée"
                                       FontSize="10" FontWeight="SemiBold"
                                       TextAlignment="Center" Margin="0,4,0,0">
                                <TextBlock.Foreground>
                                    <SolidColorBrush x:Name="brushEtape3Text" Color="#64748B"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Message d'état -->
                <Border Grid.Column="1" Background="#252840" CornerRadius="10"
                        Padding="16,12" VerticalAlignment="Center" MinWidth="220">
                    <StackPanel>
                        <TextBlock Text="💬  Message de statut" FontSize="9" FontWeight="Bold"
                                   Foreground="#64748B" Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtDetailMessage"
                                   Foreground="#94A3B8" FontSize="11"
                                   TextWrapping="Wrap" MaxWidth="260"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ PIED ═════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#252840"
                BorderThickness="0,1,0,0" BorderBrush="#334155">
            <TextBlock x:Name="txtFooter"
                       Text="FleetManager  •  Suivi des commandes"
                       Foreground="#4B5563" FontSize="11"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
