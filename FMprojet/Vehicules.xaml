<Window x:Class="FMprojet.Views.Vehicules"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FleetManager – Catalogue Véhicules"
        Height="700" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#1A1D2E">

    <Window.Resources>
        <!-- Couleurs principales -->
        <SolidColorBrush x:Key="AccentBlue"    Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentGreen"   Color="#10B981"/>
        <SolidColorBrush x:Key="CardBg"        Color="#252840"/>
        <SolidColorBrush x:Key="InputBg"       Color="#1E2035"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderColor"   Color="#334155"/>

        <!-- Style DataGrid Header -->
        <Style x:Key="DgHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="#1A1D2E"/>
            <Setter Property="Foreground"   Value="#94A3B8"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"  Value="#334155"/>
        </Style>

        <!-- Style DataGrid Row -->
        <Style x:Key="DgRowStyle" TargetType="DataGridRow">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="#F1F5F9"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="BorderBrush"  Value="#334155"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D3250"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3B4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style DataGrid Cell -->
        <Style x:Key="DgCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding"          Value="10,6"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="#F1F5F9"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style Button Primaire (Bleu) -->
        <Style x:Key="BtnPrimaire" TargetType="Button">
            <Setter Property="Background"       Value="#3B82F6"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Padding"          Value="16,8"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Button Commander (Vert) -->
        <Style x:Key="BtnCommander" TargetType="Button" BasedOn="{StaticResource BtnPrimaire}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Button Retour (Neutre) -->
        <Style x:Key="BtnSecondaire" TargetType="Button" BasedOn="{StaticResource BtnPrimaire}">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style TextBox de recherche -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background"       Value="#1E2035"/>
            <Setter Property="Foreground"       Value="#F1F5F9"/>
            <Setter Property="CaretBrush"       Value="#3B82F6"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Padding"          Value="10,8"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="BorderBrush"      Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- En-tête -->
            <RowDefinition Height="70"/>
            <!-- Contenu principal -->
            <RowDefinition Height="*"/>
            <!-- Pied de page -->
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  EN-TÊTE                                               -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#252840" BorderThickness="0,0,0,1" BorderBrush="#334155">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Titre + Icône -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Carré accent -->
                    <Border Width="36" Height="36" CornerRadius="8" Background="#3B82F6" Margin="0,0,12,0">
                        <TextBlock Text="🚗" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Catalogue des Véhicules"
                                   Foreground="#F1F5F9" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="txtUtilisateurInfo"
                                   Foreground="#94A3B8" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Boutons header -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnMesCommandes"
                            Content="📋  Mes Commandes"
                            Style="{StaticResource BtnSecondaire}"
                            Padding="14,7"
                            Margin="0,0,10,0"
                            Visibility="Collapsed"
                            Click="BtnMesCommandes_Click"/>
                    <Button x:Name="btnRetour"
                            Content="← Retour"
                            Style="{StaticResource BtnSecondaire}"
                            Padding="14,7"
                            Click="BtnRetour_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  CONTENU PRINCIPAL                                     -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="24,20,24,0">
            <Grid.RowDefinitions>
                <!-- Barre de recherche -->
                <RowDefinition Height="Auto"/>
                <!-- DataGrid véhicules -->
                <RowDefinition Height="*"/>
                <!-- Séparateur + panneau Mes Commandes (client uniquement) -->
                <RowDefinition x:Name="rowCommandes" Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Barre de recherche ── -->
            <Border Grid.Row="0"
                    Background="#252840"
                    CornerRadius="12"
                    Padding="16,12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Champ de recherche avec placeholder -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <TextBox x:Name="txtReference"
                                 Style="{StaticResource SearchBox}"
                                 Height="38"
                                 KeyDown="TxtReference_KeyDown"/>
                        <!-- Texte placeholder (masqué quand le TextBox a du contenu) -->
                        <TextBlock x:Name="txtPlaceholder"
                                   Text="🔍  Rechercher par marque, modèle, immatriculation, carburant…"
                                   Foreground="#4B5563"
                                   FontSize="13"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Bouton Rechercher -->
                    <Button Grid.Column="1"
                            x:Name="btnRechercher"
                            Content="Rechercher"
                            Style="{StaticResource BtnPrimaire}"
                            Height="38"
                            Margin="0,0,8,0"
                            Click="BtnRechercher_Click"/>

                    <!-- Bouton Tout afficher -->
                    <Button Grid.Column="2"
                            x:Name="btnTout"
                            Content="Tout afficher"
                            Style="{StaticResource BtnSecondaire}"
                            Height="38"
                            Click="BtnTout_Click"/>
                </Grid>
            </Border>

            <!-- ── DataGrid des Véhicules ── -->
            <Border Grid.Row="1"
                    Background="#252840"
                    CornerRadius="12"
                    Margin="0,0,0,16"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="#334155">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Tous les véhicules"
                                           Foreground="#F1F5F9"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <!-- Badge explicatif sur les critères de commande -->
                                <Border Background="#334155" CornerRadius="20" Padding="7,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Seuls les véhicules de &lt; 4 ans et &lt; 80 000 km sont commandables"
                                               FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="txtCompteurVehicules"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                              x:Name="dgVehicules"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#2D3149"
                              RowHeaderWidth="0"
                              ColumnHeaderStyle="{StaticResource DgHeaderStyle}"
                              RowStyle="{StaticResource DgRowStyle}"
                              CellStyle="{StaticResource DgCellStyle}"
                              SelectionChanged="DgVehicules_SelectionChanged"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"            Binding="{Binding Id}"             Width="50"/>
                            <DataGridTextColumn Header="Marque"        Binding="{Binding Marque}"         Width="110"/>
                            <DataGridTextColumn Header="Modèle"        Binding="{Binding Modele}"         Width="130"/>
                            <DataGridTextColumn Header="Immat."        Binding="{Binding Immatriculation}" Width="110"/>
                            <DataGridTextColumn Header="Année"         Binding="{Binding Annee}"          Width="70"/>
                            <DataGridTextColumn Header="Prix (€)"      Binding="{Binding Prix, StringFormat=N2}" Width="90"/>
                            <DataGridTextColumn Header="Kilométrage"   Binding="{Binding Kilometrage, StringFormat=N0}" Width="100"/>
                            <DataGridTextColumn Header="Carburant"     Binding="{Binding Carburant}"      Width="90"/>
                            <DataGridTextColumn Header="Transmission"  Binding="{Binding Transmission}"   Width="100"/>
                            
                            <!-- Colonne d'action (Bouton Commander) -->
                            <DataGridTemplateColumn x:Name="colActionCommander" Width="110" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Commander" 
                                                Style="{StaticResource BtnCommander}" 
                                                Padding="8,4" 
                                                Height="28" 
                                                FontSize="11"
                                                IsEnabled="{Binding EstCommandable}"
                                                Click="BtnCommanderDirect_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bouton Commander (visible seulement pour les clients) -->
                    <Border Grid.Row="2"
                            x:Name="panneauCommander"
                            Visibility="Collapsed"
                            Padding="16,12"
                            BorderThickness="0,1,0,0"
                            BorderBrush="#334155">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Véhicule sélectionné : "
                                           Foreground="#94A3B8"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtVehiculeSelectionne"
                                           Text="—"
                                           Foreground="#F1F5F9"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="btnCommander"
                                    Content="🛒  Commander ce véhicule"
                                    Style="{StaticResource BtnCommander}"
                                    Height="38"
                                    Padding="20,8"
                                    HorizontalAlignment="Right"
                                    IsEnabled="False"
                                    Click="BtnCommander_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Panneau "Mes Commandes" (aperçu rapide, clients uniquement) ── -->
            <Border Grid.Row="2"
                    x:Name="panneauMesCommandes"
                    Background="#252840"
                    CornerRadius="12"
                    Margin="0,0,0,0"
                    Visibility="Collapsed"
                    MaxHeight="180">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="#334155">
                        <Grid>
                            <TextBlock Text="📋  Mes dernières commandes"
                                       Foreground="#F1F5F9"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btnVoirToutesCommandes"
                                        Content="Voir tout →"
                                        Style="{StaticResource BtnPrimaire}"
                                        Padding="10,4" FontSize="11"
                                        Margin="0,0,8,0"
                                        Click="BtnMesCommandes_Click"/>
                                <Button x:Name="btnRafraichirCommandes"
                                        Content="↻ Rafraîchir"
                                        Style="{StaticResource BtnSecondaire}"
                                        Padding="10,4"
                                        FontSize="11"
                                        Click="BtnRafraichirCommandes_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              x:Name="dgMesCommandes"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#2D3149"
                              RowHeaderWidth="0"
                              ColumnHeaderStyle="{StaticResource DgHeaderStyle}"
                              RowStyle="{StaticResource DgRowStyle}"
                              CellStyle="{StaticResource DgCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N°" Binding="{Binding Id}"                  Width="60"/>
                            <DataGridTextColumn Header="Véhicule"    Binding="{Binding VehiculeMarqueModele}" Width="*"/>
                            <DataGridTextColumn Header="Statut"      Binding="{Binding Statut}"               Width="110"/>
                            <DataGridTextColumn Header="Date"        Binding="{Binding DateCommande, StringFormat=dd/MM/yyyy}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  PIED DE PAGE                                          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#252840" BorderThickness="0,1,0,0" BorderBrush="#334155">
            <TextBlock Text="FleetManager  •  Catalogue des véhicules"
                       Foreground="#4B5563"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
