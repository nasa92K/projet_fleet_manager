<Window x:Class="projet_fleet_manager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion - Fleet Manager"
        Height="500"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="89"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#2C3E50" Margin="0,0,0,378" Grid.RowSpan="2">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🚗" FontSize="48" HorizontalAlignment="Center" Foreground="White"/>
                <TextBlock Text="Fleet Manager" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="White" CornerRadius="10" Margin="30,40,30,30" Padding="30">
            <Border.Effect>
                <DropShadowEffect Color="#CCCCCC" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Connexion" FontSize="20" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,30" HorizontalAlignment="Center"/>
                <TextBlock Text="Nom d'utilisateur" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUsername" Height="40" FontSize="14" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,0,20"/>
                <TextBlock Text="Mot de passe" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Height="40" FontSize="14" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,0,10"/>
                <TextBlock x:Name="txtError" Text="" Foreground="Red" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15" Visibility="Collapsed"/>
                <Button x:Name="btnLogin" Content="Se connecter" Height="45" FontSize="14" FontWeight="SemiBold"
                        Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnLogin_Click" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
